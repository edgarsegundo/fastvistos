---
/**
 * Footer B2B — logo, links, copyright. Fundo navy.
 */
const year = new Date().getFullYear();
---

<footer class="footer" id="contato" role="contentinfo">
  <div class="footer__inner">
    <div class="footer__top">
      <a href="/" class="footer__logo">
        <img
          src="/assets/images/logo/criacurriculo_logo_icone.svg"
          alt=""
          class="footer__logo-icon"
          width="34"
          height="34"
        />
        Cria<span>Currículo</span>
      </a>
      <nav class="footer__links" aria-label="Links do rodapé">
        <a href="#como-funciona" class="footer__link">Como funciona</a>
        <a href="#faq" class="footer__link">Dúvidas</a>
        <a href="/politica-de-privacidade/" class="footer__link">Privacidade</a>
        <a href="#" class="footer__link">Termos de uso</a>
      </nav>
    </div>
    <div class="footer__bottom">
      <p class="footer__copy">© {year} Cria Currículo. Todos os direitos reservados.</p>
      <!-- TODO: link de rede social real — mocado por enquanto -->
      <a href="#" class="footer__social" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--color-bg); padding: 56px 24px 26px; border-top: 1px solid rgba(255,255,255,.06); }
  .footer__inner { max-width: var(--max-w); margin: 0 auto; }
  .footer__top { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; padding-bottom: 32px; border-bottom: 1px solid rgba(255,255,255,.08); }
  .footer__logo { display: inline-flex; align-items: center; gap: 4px; font-family: var(--font-display); font-weight: 900; font-size: 20px; color: #fff; text-decoration: none; letter-spacing: -.01em; }
  .footer__logo-icon { display: block; flex-shrink: 0; }
  .footer__logo span { color: var(--color-cta); }
  .footer__links { display: flex; gap: 24px; flex-wrap: wrap; }
  .footer__link { font-family: var(--font-display); font-size: 13px; font-weight: 500; color: rgba(255,255,255,.7); text-decoration: none; transition: color .2s; }
  .footer__link:hover { color: #fff; }

  .footer__bottom { padding-top: 22px; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .footer__copy { font-size: 12px; color: rgba(255,255,255,.5); margin: 0; }
  .footer__social { width: 32px; height: 32px; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,.6); transition: color .2s; }
  .footer__social:hover { color: #fff; }

  @media (max-width: 640px) {
    .footer__top, .footer__bottom { flex-direction: column; text-align: center; }
  }
</style>
