---
/** "Sem complicação. Resultado real." — 3 passos. [PREENCHER] */
import EaPlaceholder from './EaPlaceholder.astro';
const passos = [
  { t: 'Conte onde dói', d: '[PREENCHER] Uma conversa curta para entender onde a empresa perde tempo e dinheiro.' },
  { t: 'Veja a solução funcionando', d: '[PREENCHER] Um protótipo simples, com os seus dados, para testar antes de decidir.' },
  { t: 'Coloque para rodar', d: '[PREENCHER] A solução entra na rotina da equipe e a economia passa a ser medida.' },
];
---
<section class="passos ea-section" id="passos">
  <div class="ea-wrap">
    <header class="passos__head">
      <h2 class="ea-title">Sem complicação. <em>Resultado real.</em></h2>
      <p class="ea-sub">[PREENCHER] Do primeiro contato à primeira economia, em três passos.</p>
    </header>
    <ol class="passos__list" role="list">
      {passos.map((p, i) => (
        <li>
          <EaPlaceholder label={`Imagem do passo ${i + 1}`} ratio="4 / 4.5" />
          <p class="passos__n">{String(i + 1).padStart(2, '0')}</p>
          <h3>{p.t}</h3>
          <p>{p.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .passos__head { text-align: center; margin: 0 auto 56px; max-width: 640px; }
  .passos__head .ea-sub { margin-inline: auto; }
  .passos__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .passos__n { font-family: var(--ea-font-mono); font-size: 12px; color: var(--ea-orange); margin: 18px 0 6px; letter-spacing: .08em; }
  .passos__list h3 { font-family: var(--ea-font-display); font-size: 22px; font-weight: 600; margin: 0 0 8px; }
  .passos__list li > p:last-child { margin: 0; color: var(--ea-mute); font-size: 16px; line-height: 1.55; }
  @media (max-width: 860px) { .passos__list { grid-template-columns: 1fr; gap: 40px; } }
</style>
