---
/** Bloco de imagem/ilustração provisório. Troque por <img> quando tiver o material. */
interface Props { label?: string; ratio?: string; icon?: string; dark?: boolean }
const { label = 'Imagem', ratio = '4 / 3', icon, dark = false } = Astro.props;
---
<div class:list={['ph', { 'ph--dark': dark }]} style={`aspect-ratio:${ratio}`} role="img" aria-label={label}>
  {icon && <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icon} />}
  <span>[PREENCHER] {label}</span>
</div>
<style>
  .ph { width: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; text-align: center; padding: 16px; color: var(--ea-ink-2);
    background-color: var(--ea-sky-soft);
    background-image: linear-gradient(var(--ea-sky) 1px, transparent 1px), linear-gradient(90deg, var(--ea-sky) 1px, transparent 1px);
    background-size: 24px 24px; border: 1px solid var(--ea-sky); }
  .ph--dark { background-color: var(--ea-ink-2); background-image: linear-gradient(rgba(255,255,255,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px); border-color: var(--ea-ink-3); color: #fff; }
  .ph svg { width: 44px; height: 44px; stroke: currentColor; fill: none; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .ph span { font-family: var(--ea-font-mono); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; opacity: .75; }
</style>
