---
/** Números — [PREENCHER] valores reais antes de publicar. */
const numeros = [
  { v: '[00]', l: 'Empresas atendidas' },
  { v: '[00h]', l: 'Horas economizadas por mês' },
  { v: '[R$ 00 mil]', l: 'Custo evitado' },
  { v: '[00]', l: 'Processos automatizados' },
];
---
<section class="num ea-section">
  <div class="ea-wrap">
    <h2 class="ea-title">[PREENCHER] Não use só a tecnologia. <em>Faça ela render.</em></h2>
    <dl class="num__grid">
      {numeros.map((n) => (
        <div><dd>{n.v}</dd><dt>{n.l}</dt></div>
      ))}
    </dl>
  </div>
</section>
<style>
  .num { background: var(--ea-ink-2); color: #fff; }
  .num .ea-title { color: #fff; max-width: 22ch; margin-bottom: 48px; }
  .num__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; margin: 0; border-top: 1px solid var(--ea-ink-3); }
  .num__grid > div { display: flex; flex-direction: column-reverse; padding: 28px 24px 8px 0; border-right: 1px solid var(--ea-ink-3); padding-left: 24px; }
  .num__grid > div:first-child { padding-left: 0; }
  .num__grid > div:last-child { border-right: 0; }
  .num dd { margin: 0; font-family: var(--ea-font-display); font-size: clamp(30px, 4vw, 48px); font-weight: 600; color: var(--ea-orange); }
  .num dt { font-family: var(--ea-font-mono); font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: #c9d2e6; margin-top: 8px; }
  @media (max-width: 760px) {
    .num__grid { grid-template-columns: 1fr 1fr; }
    .num__grid > div { padding: 20px 12px; border-right: 0; border-bottom: 1px solid var(--ea-ink-3); }
    .num__grid > div:first-child { padding-left: 12px; }
  }
</style>
