---
// ContratarAqui — Landing Page B2B (empresas parceiras de recrutamento)
import SharedHomeLayout from '../layouts/SharedHomeLayout.astro';
import { siteConfig } from '../site-config.ts';
import JsonLdHomePageBase from '../components/JsonLdHomePageBase.astro';

import ContratarNavbar from '../components/ContratarNavbar.astro';
import ContratarHero from '../components/ContratarHero.astro';
import ContratarComoFunciona from '../components/ContratarComoFunciona.astro';
import ContratarParaEmpresas from '../components/ContratarParaEmpresas.astro';
import ContratarFaq from '../components/ContratarFaq.astro';
import ContratarFooter from '../components/ContratarFooter.astro';
import MetaPixel from '../components/MetaPixel.astro';

const { bodyClass = '', bodyStyle = '' } = Astro.props;
---

<SharedHomeLayout
    bodyClass={`${bodyClass} antialiased`}
    bodyStyle={`${bodyStyle}`}
    themeToggleDisable={true}
    canonicalConf={siteConfig.site.canonical}
    faviconPathFromConf={siteConfig.site.faviconPath}
    seoFromConf={siteConfig.homePageConfig.seo}
    titleFromConf={siteConfig.homePageConfig.seo.title}
    descriptionFromConf={siteConfig.homePageConfig.seo.description}
    authorNameFromConf={siteConfig.site.authorName}
    imageFromConf={null}
    imageUrlFromConf={siteConfig.site.primaryImage.url}
    imageCaptionFromConf={siteConfig.site.primaryImage.alt}
    imageWidthFromConf={siteConfig.site.primaryImage.width}
    imageHeightFromConf={siteConfig.site.primaryImage.height}
>
    <Fragment slot="head">
        <link
          rel="preload"
          as="style"
          href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap"
          onload="this.onload=null;this.rel='stylesheet'"
        />
        <JsonLdHomePageBase faqList={[]} servicesList={[]} reviewsList={[]} disableReviews={false} />
        <MetaPixel />
    </Fragment>

    <ContratarNavbar />
    <ContratarHero />
    <ContratarComoFunciona />
    <ContratarParaEmpresas />
    <ContratarFaq />
    <ContratarFooter />
</SharedHomeLayout>
