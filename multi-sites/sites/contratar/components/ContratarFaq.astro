---
/** Perguntas frequentes — lista de definição + foto de entrevista por vídeo. */
const faqs = [
  { q: 'Preciso publicar uma vaga?', a: 'Você pode ir direto à busca de candidatos por cargo e cidade e consultar os perfis disponíveis.' },
  { q: 'Como funcionam os 5 contatos grátis?', a: 'Ao criar uma conta de empresa, você recebe cinco contatos para experimentar. Use esses contatos nos perfis que quiser chamar pelo WhatsApp.' },
  { q: 'Quem faz a entrevista e decide a contratação?', a: 'Sua empresa conversa com o candidato, avalia as informações e decide os próximos passos. Os currículos usam dados declarados pelos candidatos.' },
  { q: 'Onde a plataforma atua?', a: 'O foco é a Região Metropolitana de Campinas, incluindo cidades como Hortolândia, Sumaré, Valinhos e Vinhedo.' },
];
---

<section class="faq" id="duvidas" aria-labelledby="titulo-duvidas">
  <div class="wrap faq__inner">
    <div class="faq__side">
      <span class="eyebrow">PERGUNTAS FREQUENTES</span>
      <h2 class="faq__title" id="titulo-duvidas">Antes de começar</h2>
      <img class="faq__img" src="/assets/images/faq/entrevista-video.webp" alt="Empregador conversando por vídeo com uma candidata sorridente" width="800" height="800" loading="lazy" decoding="async" />
    </div>
    <dl class="faq__list">
      {faqs.map((f) => (
        <div class="faq__item">
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .faq { background: #fff; scroll-margin-top: 72px; }
  .faq__inner { padding-block: 88px; display: flex; flex-wrap: wrap; gap: 48px; }
  .faq__side { flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  .eyebrow { font-family: var(--font-display); font-size: 12px; font-weight: 600; letter-spacing: 3px; color: #2e7d46; }
  .faq__title { margin: 0; font-family: var(--font-serif); font-size: clamp(28px, 3.4vw, 42px); font-weight: 400; color: #1e2a36; }
  .faq__img { flex: 1 1 0; min-height: 260px; width: 100%; height: auto; margin-top: 16px; object-fit: cover; object-position: 55% 45%; border-radius: 18px; display: block; }
  .faq__list { flex: 2 1 560px; min-width: 0; margin: 0; display: flex; flex-direction: column; }
  .faq__item { padding: 20px 0; border-top: 1px solid #eceff3; display: flex; flex-direction: column; gap: 6px; }
  .faq__item:last-child { border-bottom: 1px solid #eceff3; }
  .faq__item dt { font-size: 17px; font-weight: 700; color: #1e2a36; }
  .faq__item dd { margin: 0; font-size: 16px; line-height: 1.55; color: #45515e; }

  @media (max-width: 760px) { .faq__inner { padding-block: 56px; } }
</style>
