---
/**
 * Navbar — fixa no topo (navy), logo + links de âncora + botão "Buscar candidatos".
 * Mobile (≤760px): links colapsam num menu hambúrguer.
 */
const utm = 'utm_source=contrataraqui&utm_medium=cta&utm_campaign=lp_principal';
const searchUrl = `https://app.empregoaqui.com.br/buscar?${utm}&utm_content=navbar`;
const searchUrlMobile = `https://app.empregoaqui.com.br/buscar?${utm}&utm_content=navbar_mobile`;
---

<header class="navbar" aria-label="Menu principal">
  <div class="navbar__inner wrap">
    <a href="/" class="navbar__logo" aria-label="ContratarAqui - página inicial">
      <img src="/assets/images/logo/contrataraqui-logo-branco.svg" alt="" width="87" height="48" />
      <span class="navbar__by">por Emprego Aqui</span>
    </a>

    <nav class="navbar__nav" aria-label="Principal">
      <a href="#como-funciona" class="navbar__link">Como funciona</a>
      <a href="#areas" class="navbar__link">Áreas de atuação</a>
      <a href="#duvidas" class="navbar__link">Dúvidas</a>
      <a href={searchUrl} data-cta="navbar" class="navbar__btn" target="_blank" rel="noopener noreferrer">Buscar candidatos</a>
    </nav>

    <button id="navbar-toggle" class="navbar__toggle" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="navbar-mobile-menu">
      <svg class="ico-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      <svg class="ico-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <div id="navbar-mobile-menu" class="navbar__mobile">
    <a href="#como-funciona" class="navbar__mobile-link">Como funciona</a>
    <a href="#areas" class="navbar__mobile-link">Áreas de atuação</a>
    <a href="#duvidas" class="navbar__mobile-link">Dúvidas</a>
    <a href={searchUrlMobile} data-cta="navbar_mobile" class="navbar__mobile-btn">Buscar candidatos</a>
  </div>
</header>

<style>
  /* Transparente, sobreposto ao hero (a foto ocupa toda a área, inclusive atrás do menu) */
  .navbar { position: absolute; top: 0; left: 0; right: 0; z-index: 100; }
  .navbar__inner { border-bottom: 1px solid rgba(255,255,255,.18); }
  .navbar__inner { display: flex; align-items: center; justify-content: space-between; min-height: 72px; padding-block: 12px; gap: 16px; }
  .navbar__logo { display: inline-flex; flex-direction: column; gap: 2px; text-decoration: none; }
  .navbar__logo img { display: block; height: 48px; width: auto; }
  .navbar__by { font-size: 12px; font-weight: 500; color: #d8dee5; }
  .navbar__nav { display: flex; align-items: center; gap: 4px; }
  .navbar__link { display: flex; align-items: center; min-height: 44px; padding: 0 14px; font-family: var(--font-display); font-size: 13px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: #fff; text-decoration: none; opacity: .85; transition: opacity .2s; }
  .navbar__link:hover { opacity: 1; }
  .navbar__btn { display: flex; align-items: center; min-height: 44px; margin-left: 8px; padding: 0 18px; border: 1px solid #fff; font-family: var(--font-display); font-size: 13px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: #fff; text-decoration: none; transition: background .2s, color .2s; }
  .navbar__btn:hover { background: #fff; color: var(--color-bg); }

  .navbar__toggle { display: none; align-items: center; justify-content: center; width: 44px; height: 44px; background: transparent; border: none; border-radius: 8px; color: #fff; cursor: pointer; }
  .navbar__toggle:hover { background: rgba(255,255,255,.08); }
  .ico-close { display: none; }
  .navbar__toggle[aria-expanded="true"] .ico-open { display: none; }
  .navbar__toggle[aria-expanded="true"] .ico-close { display: block; }

  .navbar__mobile { display: none; flex-direction: column; padding: 8px 24px 20px; background: rgba(20,26,32,.96); }
  .navbar__mobile.is-open { display: flex; }
  .navbar__mobile-link { font-family: var(--font-display); font-size: 15px; font-weight: 600; color: rgba(255,255,255,.85); text-decoration: none; padding: 14px 4px; border-bottom: 1px solid rgba(255,255,255,.06); }
  .navbar__mobile-btn { font-family: var(--font-display); font-size: 15px; font-weight: 700; color: var(--color-bg); background: var(--color-cta); padding: 14px 22px; border-radius: 8px; text-decoration: none; text-align: center; margin-top: 16px; }

  @media (max-width: 760px) {
    .navbar__nav { display: none; }
    .navbar__toggle { display: inline-flex; }
  }
</style>

<script>
  const toggle = document.getElementById('navbar-toggle');
  const menu = document.getElementById('navbar-mobile-menu');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    };
    toggle.addEventListener('click', () => setOpen(!menu.classList.contains('is-open')));
    menu.querySelectorAll('a').forEach((l) => l.addEventListener('click', () => setOpen(false)));
    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (menu.classList.contains('is-open') && !toggle.contains(t) && !menu.contains(t)) setOpen(false);
    });
  }
</script>
