---
/**
 * Hero B2B — fundo navy sólido (sem foto/slideshow), texto à esquerda,
 * imagem do app com a lista de candidatos à direita.
 */

// Link para seção "Para empresas" (scroll âncora)
const contactUrl = 'https://app.empregoaqui.com.br/buscar';
---

<section class="hero" id="topo" aria-labelledby="hero-title">
  <div class="hero__dots" aria-hidden="true"></div>

  <div class="hero__inner wrap">
    <div class="hero__content">
      <h1 class="hero__title" id="hero-title">
        <span class="hero__title-accent">Precisa contratar?</span>
        Encontre seu próximo candidato aqui.
      </h1>

      <p class="hero__sub">
        Encontre candidatos por cargo e região, veja os perfis disponíveis e
        fale diretamente com quem pode fazer parte da sua equipe.
      </p>

      <div class="hero__actions">
        <a href="#como-funciona" class="btn btn--ghost">Como funciona</a>
        <a href={contactUrl} class="btn btn--coral" target="_blank" rel="noopener noreferrer">Procurar candidatos →</a>
      </div>

      <div class="hero__trust">
        <span class="hero__trust-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#F28B30" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          5 créditos grátis para começar
        </span>
        <span class="hero__trust-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#F28B30" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          Sem mensalidade
        </span>
        <span class="hero__trust-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#F28B30" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
          Sem burocracia
        </span>
      </div>
    </div>

    <div class="hero__panel">
      <img
        src="/assets/images/hero/lista-app-candidatos.webp"
        alt="Lista de candidatos disponíveis com contato direto pelo WhatsApp"
        class="hero__panel-img"
        width="998"
        height="1184"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .hero { background: var(--color-bg); padding: 88px 0 96px; position: relative; overflow: hidden; }
  .hero__dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,.05) 1px, transparent 1px);
    background-size: 26px 26px;
    opacity: .5;
  }

  .hero__inner { position: relative; display: flex; gap: 56px; align-items: center; flex-wrap: wrap; }
  .hero__content { flex: 1 1 480px; min-width: 320px; }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(34px, 4.4vw, 52px);
    font-weight: 800;
    line-height: 1.12;
    color: #fff;
    margin: 0 0 24px;
  }
  .hero__title-accent { display: block; color: var(--color-cta); }

  .hero__sub { font-size: 17px; line-height: 1.6; color: rgba(255,255,255,.9); max-width: 520px; margin: 0 0 32px; }

  .hero__actions { display: flex; gap: 20px; flex-wrap: wrap; margin-bottom: 40px; }
  .btn {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    padding: 15px 28px;
    border-radius: 8px;
    text-decoration: none;
    display: inline-flex;
    transition: all .2s;
  }
  .btn--coral { color: var(--color-bg); background: var(--color-cta); border: 1.5px solid var(--color-cta); }
  .btn--coral:hover { background: var(--color-cta-dark); border-color: var(--color-cta-dark); }
  .btn--ghost { color: var(--color-cta); background: transparent; border: 1.5px solid var(--color-cta); }
  .btn--ghost:hover { background: rgba(242,139,48,.1); }

  .hero__trust { display: flex; gap: 24px; flex-wrap: wrap; }
  .hero__trust-item { font-size: 14px; color: rgba(255,255,255,.9); display: flex; align-items: center; gap: 8px; }

  .hero__panel { flex: 1 1 380px; min-width: 300px; max-width: 580px; }
  .hero__panel-img { display: block; width: 100%; height: auto; }

  @media (max-width: 860px) {
    .hero__inner { flex-direction: column; align-items: stretch; }
    .hero__panel { max-width: 480px; margin: 0 auto; }
  }

  @media (max-width: 760px) {
    .hero { padding: 28px 0 48px; }
    .hero__panel { display: none; }
  }
</style>
