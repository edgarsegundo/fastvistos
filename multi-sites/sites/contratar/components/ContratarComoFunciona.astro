---
/**
 * Como funciona — bloco dividido: painel laranja (título) + lista de 3 passos.
 */
const passos = [
  { title: 'Busque por cargo e cidade', desc: 'Comece pelo profissional de que você precisa e pela cidade onde fica a vaga.', icon: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>' },
  { title: 'Consulte os currículos', desc: 'Veja a experiência e as informações declaradas pelo candidato antes de decidir com quem falar.', icon: '<path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/><path d="M10 13h6"/><path d="M10 17h6"/>' },
  { title: 'Convide para conversar', desc: 'Use um contato para chamar pelo WhatsApp e combinar a próxima etapa da seleção.', icon: '<path d="M21 11.5a8.4 8.4 0 0 1-12.4 7.4L3 21l2.1-5.5A8.4 8.4 0 1 1 21 11.5z"/>' },
];
---

<section class="como" id="como-funciona" aria-labelledby="titulo-como">
  <div class="como__left">
    <span class="como__eyebrow">COMO FUNCIONA</span>
    <h2 class="como__title" id="titulo-como">Da busca à primeira conversa</h2>
    <p class="como__sub">Você escolhe os perfis e conduz a seleção no ritmo da sua empresa.</p>
  </div>
  <div class="como__right">
    <ol class="como__list">
      {passos.map((p) => (
        <li class="como__item">
          <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#d9721a" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.icon} />
          <div class="como__item-text">
            <h3>{p.title}</h3>
            <p>{p.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .como { display: flex; flex-wrap: wrap; scroll-margin-top: 72px; }
  .como__left { flex: 1 1 440px; min-width: 0; background: var(--color-cta); padding: 80px 56px; display: flex; flex-direction: column; justify-content: center; gap: 16px; }
  .como__eyebrow { font-family: var(--font-display); font-size: 12px; font-weight: 600; letter-spacing: 3px; color: #231a12; }
  .como__title { margin: 0; font-family: var(--font-serif); font-size: clamp(30px, 3.6vw, 46px); line-height: 1.1; font-weight: 400; color: #231a12; }
  .como__sub { margin: 0; font-size: 18px; line-height: 1.55; color: #3a2716; max-width: 440px; }
  .como__right { flex: 1 1 520px; min-width: 0; background: #fff; padding: 56px; display: flex; align-items: center; }
  .como__list { margin: 0; padding: 0; list-style: none; width: 100%; display: flex; flex-direction: column; }
  .como__item { display: flex; gap: 20px; align-items: flex-start; padding: 26px 0; border-bottom: 1px solid #eceff3; }
  .como__item svg { flex-shrink: 0; }
  .como__item-text { display: flex; flex-direction: column; gap: 6px; }
  .como__item h3 { margin: 0; font-family: var(--font-serif); font-size: 22px; font-weight: 400; color: #1e2a36; }
  .como__item p { margin: 0; font-size: 16px; line-height: 1.55; color: #45515e; }

  @media (max-width: 760px) {
    .como__left { padding: 40px 20px; }
    .como__right { padding: 24px 20px; }
    .como__item { gap: 14px; padding: 20px 0; }
    .como__item h3 { font-size: 19px; }
  }
</style>
