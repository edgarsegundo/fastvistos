---
/**
 * Como Funciona (B2B) — 3 passos com ilustração.
 * Grid: 3 colunas no desktop, 1 coluna em ≤900px.
 */

// TODO: link mocado — trocar por WhatsApp/chat real quando definido
const contactUrl = 'https://app.empregoaqui.com.br/buscar';

const steps = [
  {
    img: '/assets/images/como-funciona/passo-1.webp',
    title: 'Crie seu cadastro',
    pill: 'Ganhe 5 créditos grátis',
    desc: 'Crie sua conta em poucos minutos e comece sua busca. Você já recebe 5 créditos para entrar em contato com candidatos.',
  },
  {
    img: '/assets/images/como-funciona/passo-2.webp',
    title: 'Procure seu candidato',
    pill: 'Filtre por cargo e região',
    desc: 'Encontre candidatos disponíveis para sua necessidade. Escolha o cargo, região e veja os perfis que fazem sentido para sua empresa.',
  },
  {
    img: '/assets/images/como-funciona/passo-3.webp',
    title: 'Entre em contato',
    pill: 'Use 1 crédito por contato',
    desc: 'Encontrou alguém interessante? Use 1 crédito para acessar o contato e fale diretamente com o candidato no WhatsApp.',
  },
];
---

<section class="funciona" id="como-funciona" aria-labelledby="funciona-title">
  <div class="wrap">
    <div class="funciona__header">
      <p class="section-label">Como funciona</p>
      <h2 class="section-title" id="funciona-title">Encontre seu candidato em 3 passos.</h2>
      <p class="section-sub">Sem agência, sem troca de e-mails e sem burocracia. Contato direto no WhatsApp.</p>
    </div>

    <div class="funciona__steps">
      {steps.map((s) => (
        <div class="step">
          <img class="step__img" src={s.img} alt="" width="400" height="300" loading="lazy" decoding="async" />
          <h3 class="step__title">{s.title}</h3>
          <span class="step__pill">{s.pill}</span>
          <p class="step__desc">{s.desc}</p>
        </div>
      ))}
    </div>

    <div class="funciona__cta">
      <a href={contactUrl} class="btn btn--coral" target="_blank" rel="noopener noreferrer">Procurar candidatos →</a>
    </div>
  </div>
</section>

<style>
  .funciona { padding: 100px 0; background: #fff; }
  .funciona__header { text-align: center; max-width: 700px; margin: 0 auto 70px; }
  .section-label { font-family: var(--font-display); font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--color-cta); margin: 0 0 12px; }
  .section-title { font-family: var(--font-display); font-size: clamp(26px, 3.4vw, 38px); font-weight: 800; color: var(--color-bg); margin: 0 0 14px; }
  .section-sub { font-size: 16px; color: var(--color-text-muted); margin: 0; }

  .funciona__steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 100px;
  }
  .step { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 0 8px; }
  .step__img { width: 100%; max-width: 240px; height: auto; aspect-ratio: 4 / 3; object-fit: contain; margin-bottom: 28px; }

  .step__title { font-family: var(--font-display); font-size: 26px; font-weight: 800; color: var(--color-bg); margin: 0 0 22px; }
  .step__pill {
    font-family: var(--font-display); font-size: 14px; font-weight: 700; color: #fff;
    background: var(--color-bg); padding: 10px 24px; border-radius: 999px; margin-bottom: 20px;
  }
  .step__desc { font-size: 16px; color: var(--color-bg); line-height: 1.6; margin: 0 auto; max-width: 320px; }

  .funciona__cta { text-align: center; margin-top: 100px; }
  .btn--coral {
    font-family: var(--font-display); font-size: 15px; font-weight: 700; color: #fff;
    background: var(--color-cta); padding: 15px 30px; border-radius: 8px; text-decoration: none;
    display: inline-flex; transition: background .2s;
  }
  .btn--coral:hover { background: var(--color-cta-dark); }

  /* Tablet: 2 colunas */
  @media (max-width: 900px) {
    .funciona { padding: 72px 0; }
    .funciona__steps { grid-template-columns: 1fr; gap: 48px; }
  }

  /* Mobile: 1 coluna */
  @media (max-width: 560px) {
    .funciona { padding: 56px 0; }
    .funciona__header { margin-bottom: 40px; }
    .funciona__steps { grid-template-columns: 1fr; gap: 36px; }
    .funciona__cta .btn--coral { width: 100%; justify-content: center; }
  }
</style>
