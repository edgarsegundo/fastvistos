---
/** Chamada final — faixa clara com título e botão. */
const searchUrl = 'https://app.empregoaqui.com.br/buscar?utm_source=contrataraqui&utm_medium=cta&utm_campaign=lp_principal&utm_content=cta_final';
---

<section class="cta" aria-labelledby="titulo-final">
  <div class="wrap">
    <div class="cta__box">
      <div class="cta__text">
        <h2 class="cta__title" id="titulo-final">Tem uma vaga para preencher?</h2>
        <p class="cta__sub">Comece pelo cargo e pela cidade. Escolha com quem quer conversar.</p>
      </div>
      <a href={searchUrl} data-cta="cta_final" class="cta__btn" target="_blank" rel="noopener noreferrer">Buscar candidatos</a>
    </div>
  </div>
</section>

<style>
  .cta { background: #fff; padding-bottom: 72px; }
  .cta__box { background: #fff3e8; border: 1px solid #f8d3b0; border-radius: 22px; padding: 36px 40px; display: flex; flex-wrap: wrap; gap: 20px; align-items: center; justify-content: space-between; }
  .cta__text { display: flex; flex-direction: column; gap: 6px; flex: 1 1 420px; min-width: 0; }
  .cta__title { margin: 0; font-family: var(--font-serif); font-size: clamp(24px, 3vw, 32px); font-weight: 400; color: #1e2a36; }
  .cta__sub { margin: 0; font-size: 17px; color: #45515e; }
  .cta__btn { display: flex; align-items: center; justify-content: center; min-height: 54px; padding: 0 28px; border-radius: 12px; background: var(--color-cta); color: #231a12; font-size: 17px; font-weight: 700; text-decoration: none; transition: background .2s; }
  .cta__btn:hover { background: var(--color-cta-dark); color: #231a12; }

  @media (max-width: 760px) {
    .cta__box { padding: 28px 20px; border-radius: 16px; }
    .cta__btn { width: 100%; }
  }
</style>
