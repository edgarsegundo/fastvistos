---
/**
 * Para Empresas (B2B) — fundo navy sólido: headline + texto (esq), imagem (dir),
 * 4 cards de benefícios e CTA centralizado.
 */

const searchUrl = 'https://app.empregoaqui.com.br/buscar';

const beneficios = [
  { title: 'Encontre rapidamente', desc: 'Veja candidatos disponíveis para sua necessidade.' },
  { title: 'Busque por região', desc: 'Encontre profissionais onde sua empresa precisa.' },
  { title: 'Fale diretamente', desc: 'Sem intermediários entre sua empresa e o candidato.' },
  { title: 'Comece agora', desc: 'Cadastre sua empresa e ganhe 5 créditos grátis.' },
];
---

<section class="b2b" id="para-empresas" aria-labelledby="b2b-title">
  <div class="wrap b2b__inner">

    <div class="b2b__top">
      <div class="b2b__left reveal">
        <h2 class="b2b__title" id="b2b-title">
          <span class="b2b__title-accent">Sua vaga está aberta.</span>
          Você não precisa esperar.
        </h2>
        <p class="b2b__text">
          Enquanto uma vaga fica aberta, sua empresa perde tempo e produtividade.
        </p>
        <p class="b2b__text">
          O ContratarAqui coloca candidatos disponíveis na sua frente para você
          pesquisar, filtrar e entrar em contato diretamente.
        </p>
      </div>

      <div class="b2b__media reveal reveal-delay-1">
        <img
          src="/assets/images/empresas/empreendedora-procurando-profissionais-para-contratar.webp"
          alt="Empreendedora procurando profissionais para contratar"
          class="b2b__img"
          loading="lazy"
          width="728"
          height="492"
        />
      </div>
    </div>

    <ul class="b2b__cards" role="list">
      {beneficios.map((b) => (
        <li class="b2b__benefit">
          <h3 class="b2b__benefit-title">{b.title}</h3>
          <p class="b2b__benefit-desc">{b.desc}</p>
        </li>
      ))}
    </ul>

    <div class="b2b__actions">
      <a href={searchUrl} class="btn btn--coral" target="_blank" rel="noopener noreferrer">Procurar candidatos →</a>
    </div>

  </div>
</section>

<style>
  .b2b { background: var(--color-bg); padding: 100px 0; }
  .b2b__inner { display: flex; flex-direction: column; gap: 56px; }

  .b2b__top { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }

  .b2b__title {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.2vw, 52px);
    font-weight: 800;
    line-height: 1.12;
    color: #fff;
    margin: 0 0 32px;
  }
  .b2b__title-accent { display: block; color: var(--color-cta); }
  .b2b__text { font-size: 18px; line-height: 1.6; color: rgba(255, 255, 255, .92); margin: 0 0 14px; max-width: 520px; }

  .b2b__media { display: flex; justify-content: flex-end; }
  .b2b__img {
    width: 100%;
    max-width: 728px;
    height: auto;
    display: block;
    border-radius: 24px;
    box-shadow: 0 30px 70px rgba(0, 0, 0, .4);
  }

  .b2b__cards { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .b2b__benefit {
    background: rgba(255, 255, 255, .06);
    border: 1px solid rgba(242, 139, 48, .6);
    border-radius: 14px;
    padding: 26px 26px 30px;
  }
  .b2b__benefit-title { font-family: var(--font-display); font-size: 20px; font-weight: 700; color: #fff; margin: 0 0 10px; }
  .b2b__benefit-desc { font-size: 16px; line-height: 1.5; color: rgba(255, 255, 255, .85); margin: 0; }

  .b2b__actions { display: flex; justify-content: center; }
  .btn {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    padding: 17px 34px;
    border-radius: 8px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all .2s;
  }
  .btn--coral { color: var(--color-bg); background: var(--color-cta); }
  .btn--coral:hover { background: var(--color-cta-dark); }

  @media (max-width: 1000px) {
    .b2b__cards { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 860px) {
    .b2b { padding: 64px 0; }
    .b2b__inner { gap: 40px; }
    .b2b__top { grid-template-columns: 1fr; gap: 36px; }
    .b2b__media { justify-content: center; }
  }

  @media (max-width: 560px) {
    .b2b { padding: 48px 0; }
    .b2b__text { font-size: 16px; }
    .b2b__cards { grid-template-columns: 1fr; gap: 16px; }
    .b2b__actions .btn { width: 100%; }
  }
</style>
