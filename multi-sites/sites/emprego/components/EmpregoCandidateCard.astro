---
/** Card estático e anonimizado de candidato (nunca mostra contato nem sobrenome). */
import type { SeoCard } from '../lib/emprego-seo.ts';

interface Props { card: SeoCard; href: string }
const { card, href } = Astro.props;
const tags = [card.faixa_etaria && `${card.faixa_etaria} anos`, card.experiencia, ...card.disponibilidade].filter(Boolean) as string[];
const place = [card.cargo, card.bairro].filter(Boolean).join(' · ');
---

<article class="cc">
  <header>
    <span class="cc__avatar" aria-hidden="true">{card.nome.charAt(0)}</span>
    <div>
      <h3 class="cc__name">{card.nome}</h3>
      <p class="cc__place">{place}</p>
    </div>
  </header>
  {tags.length > 0 && <ul class="cc__tags">{tags.map((t) => <li>{t}</li>)}</ul>}
  <p class="cc__text">{card.resumo}</p>
  <a class="cc__btn" href={href} rel="nofollow">Chamar no WhatsApp</a>
</article>

<style>
  .cc { display: flex; flex-direction: column; gap: 12px; padding: 18px; border-radius: var(--radius); background: var(--color-surface); border: 1px solid rgba(30,34,55,.08); }
  .cc header { display: flex; gap: 12px; align-items: center; }
  .cc__avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--color-bg-dark); color: #fff; display: grid; place-items: center; font-family: var(--font-display); font-weight: 700; flex: none; }
  .cc__name { font-family: var(--font-display); font-size: 17px; margin: 0; }
  .cc__place { margin: 2px 0 0; font-size: 14px; color: var(--color-muted); }
  .cc__tags { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0; margin: 0; }
  .cc__tags li { font-size: 12.5px; padding: 3px 10px; border-radius: 999px; background: #fff; border: 1px solid rgba(30,34,55,.1); }
  .cc__text { margin: 0; font-size: 15px; line-height: 1.55; flex: 1; }
  .cc__btn { display: block; text-align: center; background: #25a244; color: #fff; font-weight: 700; font-family: var(--font-display); padding: 11px 14px; border-radius: 10px; text-decoration: none; }
  .cc__btn:hover { background: #1e8a39; }
</style>
