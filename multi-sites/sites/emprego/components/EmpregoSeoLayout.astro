---
/**
 * Moldura das páginas de SEO programático: SharedHomeLayout + navbar + footer
 * + CSS compartilhado (.seo-*). O JSON-LD entra pelo slot "jsonld".
 */
import SharedHomeLayout from '../layouts/SharedHomeLayout.astro';
import { siteConfig } from '../site-config.ts';
import EmpregoNavbar from './EmpregoNavbar.astro';
import EmpregoFooter from './EmpregoFooter.astro';
import EmpregoChatBar from './EmpregoChatBar.astro';
import MetaPixel from './MetaPixel.astro';

interface Props {
    canonical: string;
    title: string;
    description: string;
    updatedDate?: string | null;
}
const { canonical, title, description, updatedDate } = Astro.props;
---

<SharedHomeLayout
    bodyClass="antialiased"
    themeToggleDisable={true}
    canonicalConf={canonical}
    faviconPathFromConf={siteConfig.site.faviconPath}
    seoFromConf={{ title, description }}
    titleFromConf={title}
    descriptionFromConf={description}
    authorNameFromConf={siteConfig.site.authorName}
    imageFromConf={null}
    imageUrlFromConf={siteConfig.site.primaryImage.url}
    imageCaptionFromConf={siteConfig.site.primaryImage.alt}
    imageWidthFromConf={siteConfig.site.primaryImage.width}
    imageHeightFromConf={siteConfig.site.primaryImage.height}
    updatedDate={updatedDate}
>
    <Fragment slot="head">
        <link
          rel="preload"
          as="style"
          href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap"
          onload="this.onload=null;this.rel='stylesheet'"
        />
        <slot name="jsonld" />
        <MetaPixel />
    </Fragment>

    <EmpregoNavbar />
    <main class="seo-main">
        <div class="seo-wrap">
            <slot />
        </div>
    </main>
    <EmpregoFooter />
    <EmpregoChatBar />
</SharedHomeLayout>

<style is:global>
  .seo-main { padding: 96px 0 56px; background: #fff; color: var(--color-text-main); font-family: var(--font-body); }
  .seo-wrap { max-width: 960px; margin: 0 auto; padding: 0 20px; }
  .seo-h1 { font-family: var(--font-display); font-weight: 800; font-size: clamp(26px, 4.4vw, 38px); line-height: 1.15; margin: 8px 0 12px; }
  .seo-updated { color: var(--color-muted); font-size: 14px; margin: 0 0 18px; }
  .seo-intro { font-size: 17px; line-height: 1.6; margin: 0 0 24px; }
  .seo-section { margin: 40px 0 0; }
  .seo-h2 { font-family: var(--font-display); font-weight: 700; font-size: clamp(20px, 3vw, 26px); margin: 0 0 16px; }
  .seo-cta {
    display: inline-block; background: var(--color-cta-strong); color: #fff; font-family: var(--font-display);
    font-weight: 700; padding: 14px 24px; border-radius: var(--radius); text-decoration: none;
  }
  .seo-cta:hover { background: var(--color-cta-strong-dark); }
  .seo-cta--center { display: block; width: fit-content; margin: 24px auto 0; }
  .seo-links { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 0; }
  .seo-links a {
    display: inline-block; padding: 8px 14px; border-radius: 999px; background: var(--color-surface);
    color: var(--color-text-main); text-decoration: none; font-size: 15px; border: 1px solid rgba(30,34,55,.08);
  }
  .seo-links a:hover { border-color: var(--color-cta-strong); color: var(--color-cta-strong); }
  .seo-faq details { border-bottom: 1px solid rgba(30,34,55,.1); padding: 14px 0; }
  .seo-faq summary { cursor: pointer; font-weight: 600; font-family: var(--font-display); }
  .seo-faq p { margin: 10px 0 0; line-height: 1.6; }
</style>
