---
/**
 * Barra flutuante mobile (chat) — fixed no bottom, visível só ≤860px.
 * Oculta ao descer o scroll, reaparece ao subir. Body ganha padding-bottom p/ não cobrir o footer.
 */
import { siteConfig } from '../site-config.ts';
const { chatUrl } = siteConfig.site.whatsapp;
const whatsappUrl = chatUrl;

---

<div class="chat-bar hidden" id="chatBar" role="complementary" aria-label="Criar currículo pelo chat">
  <a
    href={whatsappUrl}
    class="chat-bar__btn"
    aria-label="Abrir chat para criar currículo"
  >
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="10" width="18" height="10" rx="2"/><circle cx="8.5" cy="15" r="1.5" fill="currentColor" stroke="none"/><circle cx="15.5" cy="15" r="1.5" fill="currentColor" stroke="none"/><path d="M12 10V6"/><circle cx="12" cy="4" r="2"/><path d="M3 14H1"/><path d="M23 14h-2"/></svg>
    Começar agora — grátis
  </a>
</div>

<style>
  .chat-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 200;
    background: var(--color-chat);
    padding: 14px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    box-shadow: 0 -4px 24px rgba(0, 0, 0, .2);
    transform: translateY(0);
    transition: transform .3s;
  }
  .chat-bar.hidden { transform: translateY(100%); }

  .chat-bar__btn {
    color: #fff;
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    justify-content: center;
    text-decoration: none;
  }

  /* Oculto em desktop */
  @media (min-width: 861px) { .chat-bar { display: none; } }
</style>

<!-- padding no body para a barra não cobrir o footer (precisa ser global) -->
<style is:global>
  @media (max-width: 860px) { body { padding-bottom: 64px; } }
</style>

<script>
  (function () {
    const bar = document.getElementById('chatBar');
    if (!bar) return;
    // Escondida no topo; aparece depois que o usuário rola ~60% da 1ª tela (passa do hero).
    const threshold = () => window.innerHeight * 0.6;
    const update = () => bar.classList.toggle('hidden', window.scrollY < threshold());
    update(); // estado inicial (escondida no topo)
    window.addEventListener('scroll', update, { passive: true });
  })();
</script>
