---
/**
 * Widget de chat — simulação de conversa exibida na coluna direita do hero (desktop).
 * Oculto em mobile (controlado pelo .hero__right do EmpregoHero).
 * Animação de entrada + bolhas + digitação 100% via CSS (sem JS).
 * Paleta: navy + coral da marca (sem referência visual a apps de terceiros).
 */
---

<div class="chat-widget">
  <div class="chat-widget__phone">

    <!-- Header: avatar + nome + status -->
    <div class="chat-widget__header">
      <div class="chat-widget__avatar">
        <img
          src="/assets/images/v2/emprego-aqui-avatar-chat-widget.webp"
          alt="Emprego Aqui"
          width="36"
          height="36"
        />
      </div>
      <div class="chat-widget__info">
        <div class="chat-widget__name">Emprego Aqui</div>
        <div class="chat-widget__status">online agora</div>
      </div>
    </div>

    <!-- Chat -->
    <div class="chat-widget__chat">
      <div class="chat-widget__bubble chat-widget__bubble--in">
        Oi! Vi que você está buscando emprego em Campinas 👋
      </div>
      <div class="chat-widget__bubble chat-widget__bubble--in delay-1">
        Nossa IA encontrou <strong>3 vagas</strong> perto de você
      </div>
      <div class="chat-widget__bubble chat-widget__bubble--out delay-2">
        Sério?! Que vagas são essas? 😮
      </div>
      <div class="chat-widget__bubble chat-widget__bubble--in delay-3">
        Vagas com salário compatível, pertinho de você 📍 Quer ver?
      </div>
      <div class="chat-widget__typing" id="chatTyping">
        <span></span><span></span><span></span>
      </div>
    </div>

    <!-- Input simulado -->
    <div class="chat-widget__footer">
      <div class="chat-widget__input">Criar meu currículo grátis...</div>
      <div class="chat-widget__send" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
      </div>
    </div>

  </div>
</div>

<style>
  .chat-widget {
    width: 300px;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(0, 0, 0, .45);
    animation: chatEntrance .7s cubic-bezier(.34, 1.56, .64, 1) .5s both;
  }
  @keyframes chatEntrance {
    from { opacity: 0; transform: translateY(32px) scale(.96); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .chat-widget__phone { background: var(--color-navy-card); display: flex; flex-direction: column; }

  .chat-widget__header {
    background: var(--color-bg-dark);
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .chat-widget__avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
  }
  .chat-widget__avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .chat-widget__name { font-family: var(--font-display); font-size: 13px; font-weight: 700; color: #fff; }
  .chat-widget__status { font-size: 11px; color: rgba(255, 255, 255, .55); margin-top: 1px; }

  .chat-widget__chat {
    padding: 16px 12px 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 180px;
    background: var(--color-navy-card);
  }

  .chat-widget__bubble {
    max-width: 85%;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 12.5px;
    line-height: 1.5;
    color: #fff;
    opacity: 0;
    animation: bubbleIn .4s ease forwards;
  }
  .chat-widget__bubble--in  { background: var(--color-navy-mid); align-self: flex-start; }
  .chat-widget__bubble--out { background: var(--color-cta-strong); align-self: flex-end; }

  .chat-widget__bubble.delay-1 { animation-delay: 1.2s; }
  .chat-widget__bubble.delay-2 { animation-delay: 2.4s; }
  .chat-widget__bubble.delay-3 { animation-delay: 3.6s; }

  @keyframes bubbleIn {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Typing indicator — aparece depois da última bolha */
  .chat-widget__typing {
    display: flex;
    align-items: center;
    gap: 4px;
    background: var(--color-navy-mid);
    align-self: flex-start;
    padding: 10px 14px;
    border-radius: 8px;
    opacity: 0;
    animation: bubbleIn .3s ease forwards;
    animation-delay: 4.6s;
  }
  .chat-widget__typing span {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, .55);
    animation: typingDot .8s ease infinite;
    animation-delay: 4.6s;
  }
  .chat-widget__typing span:nth-child(2) { animation-delay: 4.75s; }
  .chat-widget__typing span:nth-child(3) { animation-delay: 4.9s; }
  @keyframes typingDot {
    0%, 60%, 100% { transform: translateY(0); opacity: .4; }
    30% { transform: translateY(-4px); opacity: 1; }
  }

  .chat-widget__footer {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    background: var(--color-navy-card);
    border-top: 1px solid rgba(255, 255, 255, .06);
  }
  .chat-widget__input {
    flex: 1;
    background: rgba(255, 255, 255, .08);
    border-radius: 20px;
    padding: 8px 14px;
    font-size: 12px;
    color: rgba(255, 255, 255, .6);
  }
  .chat-widget__send {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-cta-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
</style>
