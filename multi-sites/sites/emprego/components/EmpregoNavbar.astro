---
/**
 * Navbar — Emprego Aqui LP M3 (ASA Propaganda)
 * Fixa no topo, glassmorphism com blur. Logo SVG.
 * Header neutro/institucional: nav de texto (Como funciona / Para empresas)
 * à esquerda-centro e "Área empresa" isolado à direita (atalho de login
 * para quem já é cliente). O CTA de candidato mora só no hero.
 * Breakpoints: links de texto somem em ≤600px; "Área empresa" sempre visível.
 */

const paraEmpresasUrl = '#para-empresas';
const areaEmpresaUrl = 'https://app.empregoaqui.com.br/buscar/';
---

<nav class="navbar" role="navigation" aria-label="Menu principal">
  <div class="navbar__inner wrap">
    <a href="/" class="navbar__logo" aria-label="Emprego Aqui - página inicial">
      <img
        src="/assets/images/v2/emprego-aqui-logo.svg"
        alt="Emprego Aqui"
        class="navbar__logo-img"
        width="180"
        height="44"
      />
    </a>

    <div class="navbar__links">
      <a href="#como-funciona" class="navbar__link">Como funciona</a>
      <a href={paraEmpresasUrl} class="navbar__link">Para empresas</a>
    </div>

    <a
      href={areaEmpresaUrl}
      class="navbar__btn"
      aria-label="Área empresa - entrar na conta"
    >
      Área empresa
    </a>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(30, 34, 55, .96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, .07);
  }

  .navbar__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .navbar__logo { display: inline-flex; align-items: center; }
  .navbar__logo-img { height: 44px; width: auto; display: block; }

  /* Links de navegação (Como funciona / Para empresas) — centralizados
     na largura total do header, separados do botão "Área empresa" à direita. */
  .navbar__links {
    display: flex;
    align-items: center;
    gap: 28px;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .navbar__link {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    color: rgba(255, 255, 255, .65);
    transition: color .2s;
    padding: 6px 0;
    text-decoration: none;
  }
  .navbar__link:hover { color: #fff; }

  /* "Área empresa" — isolado no canto direito, estilo de botão em destaque
     (borda laranja da marca) para diferenciar de um item de menu comum. */
  .navbar__btn {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    padding: 8px 20px;
    border-radius: 30px;
    border: 1.5px solid var(--color-cta-strong);
    color: #fff;
    background: transparent;
    transition: all .2s;
    text-decoration: none;
    white-space: nowrap;
  }
  .navbar__btn:hover {
    background: var(--color-cta-strong);
    box-shadow: 0 2px 12px rgba(242, 139, 48, .35);
  }

  /* Mobile: oculta links de texto (podem virar hamburger futuramente),
     mas "Área empresa" continua sempre visível — atalho de cliente recorrente. */
  @media (max-width: 600px) {
    .navbar__links { display: none; }
    .navbar__inner { justify-content: space-between; }
  }
</style>
