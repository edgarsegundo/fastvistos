---
/**
 * Seção de Vídeo — texto à esquerda + player à direita.
 * Embed do YouTube com lazy-loading (facade): carrega só a thumbnail do CDN
 * do YouTube até o clique, então injeta o iframe. Otimizado p/ Lighthouse.
 * Ref.: docs/*Manual-Vídeo-YouTube-Site.md
 * Seção abaixo da dobra → usa loading="lazy" e SEM fetchpriority="high".
 */
import { siteConfig } from '../site-config.ts';
const { chatUrl } = siteConfig.site.whatsapp;
const whatsappUrl = chatUrl;

const videoId = 'wfUA5ZJstgM';
// maxresdefault (1280×720) para desktop; hqdefault (480×360) para mobile.
// Lighthouse flagou o maxresdefault servido a 637px — hqdefault (~15 KB) é suficiente.
const thumbDesktop = `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`;
const thumbMobile  = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
---

<!-- dns-prefetch (e não preconnect) de propósito: o player só carrega no clique,
     então não vale gastar uma das ~4 conexões preconnect recomendadas pelo
     Lighthouse com um recurso abaixo da dobra. Mantém só o DNS resolvido. -->
<link rel="dns-prefetch" href="https://www.youtube-nocookie.com">
<link rel="dns-prefetch" href="https://i.ytimg.com">

<section class="video-sec" aria-labelledby="video-title">
  <div class="wrap video-sec__inner reveal">

    <div class="video-sec__content">
      <p class="section-label">Veja como é simples</p>
      <h2 class="section-title section-title--white" id="video-title">Do chat<br>ao emprego</h2>
      <p class="section-sub section-sub--white">
        Assista e veja como funciona na prática. Em menos de 2 minutos você entende
        por que a Emprego Aqui é diferente de tudo que você já usou.
      </p>
      <a href={whatsappUrl} class="btn btn--coral video-sec__cta">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="10" width="18" height="10" rx="2"/><circle cx="8.5" cy="15" r="1.5" fill="currentColor" stroke="none"/><circle cx="15.5" cy="15" r="1.5" fill="currentColor" stroke="none"/><path d="M12 10V6"/><circle cx="12" cy="4" r="2"/><path d="M3 14H1"/><path d="M23 14h-2"/></svg>
        Quero começar agora
      </a>
    </div>

    <div class="video-sec__player">
      <button
        class="video-thumb"
        id="videoThumb"
        type="button"
        data-video-id={videoId}
        aria-label="Reproduzir vídeo: Do chat ao emprego"
      >
        <picture>
          {/* Mobile ≤860px: hqdefault (480×360, ~15 KB).
              Desktop: maxresdefault (1280×720, ~120 KB) — nítida na tela grande.
              onerror no <img> garante fallback se maxresdefault não existir ainda. */}
          <source media="(max-width: 860px)" srcset={thumbMobile} width="480" height="360" />
          <img
            src={thumbDesktop}
            data-fallback={thumbMobile}
            alt="Vídeo demonstrativo da Emprego Aqui"
            width="1280"
            height="720"
            decoding="async"
            loading="lazy"
            onerror="if(this.dataset.fallback){this.src=this.dataset.fallback;this.removeAttribute('data-fallback');}"
          />
        </picture>
        <span class="play-button" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </span>
      </button>
    </div>

  </div>
</section>

<style>
  .video-sec { padding: 96px 0; background: var(--color-bg-dark); }
  /* Fundo escuro → coral vibrante mantém ótimo contraste (6,36:1). */
  .video-sec .section-label { color: var(--color-cta); }
  .video-sec__inner {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 56px;
    align-items: center;
  }

  .video-sec__cta { margin-top: 28px; }

  /* Player (facade do YouTube) */
  .video-sec__player { width: 100%; }
  .video-thumb {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    cursor: pointer;
    aspect-ratio: 16 / 9;       /* zero CLS */
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
    background: #000;
  }
  .video-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Botão de play */
  .video-thumb .play-button {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: rgba(20, 23, 42, .6);
    color: #fff;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background .2s, transform .2s;
  }
  .video-thumb .play-button svg { margin-left: 4px; }
  .video-thumb:hover .play-button {
    background: rgba(20, 23, 42, .85);
    transform: translate(-50%, -50%) scale(1.06);
  }

  /* Iframe injetado após o clique */
  .video-thumb iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* ── MOBILE ── */
  @media (max-width: 860px) {
    .video-sec { padding: 72px 0; }
    .video-sec__inner { grid-template-columns: 1fr; gap: 36px; }
  }
</style>

<script>
  (function () {
    const thumb = document.getElementById('videoThumb');
    if (!thumb) return;
    thumb.addEventListener('click', () => {
      const id = thumb.getAttribute('data-video-id');
      if (!id) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
      iframe.title = 'Vídeo empregoaqui.com.br';
      iframe.allow = 'autoplay; encrypted-media';
      iframe.setAttribute('allowfullscreen', '');
      // Estilos inline: o iframe é criado em runtime e não recebe o
      // atributo de escopo do Astro, então o CSS .video-thumb iframe não
      // se aplicaria a ele.
      iframe.style.cssText =
        'position:absolute;top:0;left:0;width:100%;height:100%;border:0;';
      thumb.innerHTML = '';
      thumb.appendChild(iframe);
    });
  })();
</script>
