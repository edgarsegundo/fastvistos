---
/**
 * Layout dos projetos do SaaS (_saas).
 *
 * Liga o design system (styles/saas.css → Tailwind + ponte de tema) e aplica
 * o tema por-tenant: injeta `:root{--brand-*}` do project.theme e os <link>
 * das fontes escolhidas. Renderiza o chrome (Header/Footer de nível de Site,
 * do project.chrome) em volta do conteúdo da página.
 */
import '../styles/saas.css';
import Header from '../chrome/Header.tsx';
import Footer from '../chrome/Footer.tsx';
import { buildBrandVars, fontLinksForKeys, type ProjectTheme } from '../theme/theme';
import { DEFAULT_CHROME, type ProjectChrome } from '../chrome/chrome';

interface Props {
    title?: string;
    description?: string;
    canonical?: string;
    faviconPath?: string;
    image?: string;
    authorName?: string;
    siteName?: string;
    themeColor?: string;
    noindex?: boolean;
    theme?: ProjectTheme | null;
    chrome?: ProjectChrome | null;
    /** Chaves extra do FONT_CATALOG usadas por blocos (Aparência por
     *  elemento, ex: Hero) — além das do tema (heading/body). Dedupe é
     *  automático em `fontLinksForKeys`. */
    extraFontKeys?: string[];
}

const {
    title,
    description,
    canonical,
    faviconPath,
    image,
    authorName,
    siteName,
    themeColor,
    noindex,
    theme,
    chrome,
    extraFontKeys,
} = Astro.props as Props;

const brandVars = buildBrandVars(theme);
const links = fontLinksForKeys([theme?.fonts?.heading, theme?.fonts?.body, ...(extraFontKeys ?? [])]);
const header = { ...DEFAULT_CHROME.header, ...(chrome?.header ?? {}) };
const footer = { ...DEFAULT_CHROME.footer, ...(chrome?.footer ?? {}) };
---

<!doctype html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        {title && <title>{title}</title>}
        {description && <meta name="description" content={description} />}
        {canonical && <link rel="canonical" href={canonical} />}
        {faviconPath && <link rel="icon" href={faviconPath} />}
        {themeColor && <meta name="theme-color" content={themeColor} />}
        {authorName && <meta name="author" content={authorName} />}
        {noindex && <meta name="robots" content="noindex, nofollow" />}
        <meta property="og:type" content="website" />
        {title && <meta property="og:title" content={title} />}
        {description && <meta property="og:description" content={description} />}
        {siteName && <meta property="og:site_name" content={siteName} />}
        {image && <meta property="og:image" content={image} />}
        {image && <meta name="twitter:card" content="summary_large_image" />}
        {links.length > 0 && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
        {links.map((href) => <link rel="stylesheet" href={href} />)}
        <slot name="jsonld" />
        {/* Tema por-tenant: só os overrides do project.theme; defaults no saas.css */}
        {brandVars && <style set:html={brandVars} />}
    </head>
    <body>
        <Header {...header} />
        <slot />
        <Footer {...footer} />
    </body>
</html>
